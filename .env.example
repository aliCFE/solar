# AI provider for quote reading, quote comparison, roof-plan reading, and
# discovered-company extraction. Kimi is used if KIMI_API_KEY is set; otherwise
# falls back to Anthropic if ANTHROPIC_API_KEY is set. Only one is required.

# Kimi (Moonshot AI) — get a key at https://platform.kimi.ai
KIMI_API_KEY=
KIMI_MODEL=kimi-k3

# Anthropic — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite database file for company accounts & published packages
DATABASE_URL="file:./dev.db"

# Secret used to sign company login session cookies — set a long random value in production
SESSION_SECRET=

# Owner/admin login for approving registered companies — visit /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty on localhost —
# AdSense doesn't serve on local/dev domains; ad slots stay empty until this is set
# on a real deployed domain with an approved AdSense account.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Serper.dev web search API key — powers the "search for new companies" button on
# /admin/discovered (free tier available at https://serper.dev). Without it,
# that button returns a clear error instead of silently doing nothing.
SERPER_API_KEY=
